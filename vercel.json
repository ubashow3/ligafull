{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server.ts"]
      }
    },
    {
       "src": "package.json",
       "use": "@vercel/static-build",
       "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/user_register.php",
      "destination": "/api/index.ts"
    },
    {
      "source": "/user_login.php",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth.php",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|.*\\.php$).*)",
      "destination": "/index.html"
    }
  ]
}
