{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/user_register.php",
      "destination": "/api/index.ts"
    },
    {
      "source": "/user_login.php",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth.php",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
